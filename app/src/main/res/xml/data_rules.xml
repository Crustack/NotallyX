<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="." />
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="file"
            path="datastore/notallyx_secure_preferences.bin" />
        <exclude
            domain="sharedpref"
            path="notallyx_keyset_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="." />
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="file"
            path="datastore/notallyx_secure_preferences.bin" />
        <exclude
            domain="sharedpref"
            path="notallyx_keyset_prefs.xml" />
    </device-transfer>
</data-extraction-rules>